SUPABASE_URL=https://gzbkafvfotuvfzayqgln.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only for running migrations (Settings -> Database -> Connection string -> URI, with the password filled in). Not used at runtime.
SUPABASE_DB_URL=

# Browser-exposed Supabase config for the Google sign-in flow and session
# cookie handling (see src/lib/supabase/browser.ts, src/lib/supabase/server.ts).
# NEXT_PUBLIC_SUPABASE_URL is the same value as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=https://gzbkafvfotuvfzayqgln.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio API key — used by the PDF resume import flow
# (src/lib/resume-extraction.ts) to call Gemini directly for structured
# extraction. Free tier, no card required. Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Base URL this app is reachable at, used server-side to call the root-level
# Python function (api/pdf-to-markdown.py) over HTTP. Vercel deployments infer
# this from VERCEL_URL automatically; only set it for local dev if needed.
APP_BASE_URL=

# Protection Bypass for Automation secret (Vercel dashboard -> Settings ->
# Deployment Protection), sent as x-vercel-protection-bypass so the Python
# function stays reachable from server code while SSO protection stays on for
# everything else. Vercel injects this automatically on deployments; set it
# locally only if your project has Deployment Protection enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Shared secret authenticating internal calls to api/pdf-to-markdown.py,
# which (unlike the rest of the app) skips the Supabase-session check in
# src/proxy.ts since it's server-to-server only. Any random string; generate
# with `openssl rand -hex 24`. Must match on both this app and the Python
# function (same env var name, same Vercel project).
PDF_TO_MARKDOWN_SECRET=

# Only needed to run the two integration test files that hit the live
# Supabase project directly (src/app/api/imports/route.test.ts,
# src/app/api/resumes/[id]/compile/route.test.ts). owner_id has a foreign
# key to auth.users, so this must be a real signed-in user's id from that
# project, not an arbitrary UUID. Sign in once via /login, then grab the id
# from Supabase's Authentication -> Users dashboard.
TEST_OWNER_ID=
