SUPABASE_URL=https://gzbkafvfotuvfzayqgln.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI for running migrations only (Settings -> Database -> Connection string).
SUPABASE_DB_URL=

# Public origin of the deployed app, no trailing slash. Used for metadataBase
# so OG/Twitter card URLs use the custom domain instead of the *.vercel.app
# alias. Baked in at build time, so changing it needs a redeploy.
NEXT_PUBLIC_SITE_URL=https://modular.samarv.me

# Browser-exposed Supabase config for Google sign-in (same URL as above).
NEXT_PUBLIC_SUPABASE_URL=https://gzbkafvfotuvfzayqgln.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key for PDF import extraction. Free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# TeX Live snapshot id for LaTeX compilation via Vercel Sandbox. Required for
# every compile to work. Run `node scripts/create-texlive-snapshot.mjs` once
# to produce it.
TEXLIVE_SNAPSHOT_ID=

# App's own base URL, used server-side to call api/pdf-to-markdown.py.
# Not set by Vercel. Left blank the code falls back to the current
# deployment's own VERCEL_URL, which is what you want on Vercel so preview
# deploys call their own copy of the function. Set it only for local dev.
APP_BASE_URL=

# Vercel deployment protection bypass secret, set automatically on deploy.
# Only needed locally if Deployment Protection is enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Shared secret between this app and api/pdf-to-markdown.py.
# Generate with `openssl rand -hex 24`, must match on both.
PDF_TO_MARKDOWN_SECRET=

# Real user id for the two live-Supabase integration tests.
# Sign in via /login, then copy the id from Supabase Auth -> Users.
TEST_OWNER_ID=

# Gemini key used only by the BYOK live tests.
TEST_BYOK_GEMINI_KEY=

# Shared secret Vercel Cron presents to /api/cron/keepalive.
# Generate with `openssl rand -hex 24`.
CRON_SECRET=
