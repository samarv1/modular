SUPABASE_URL=https://gzbkafvfotuvfzayqgln.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI for running migrations only (Settings -> Database -> Connection string).
SUPABASE_DB_URL=

# Browser-exposed Supabase config for Google sign-in (same URL as above).
NEXT_PUBLIC_SUPABASE_URL=https://gzbkafvfotuvfzayqgln.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key for PDF import extraction. Free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# App's own base URL, used server-side to call api/pdf-to-markdown.py.
# Vercel sets this automatically; only needed for local dev.
APP_BASE_URL=

# Vercel deployment protection bypass secret, set automatically on deploy.
# Only needed locally if Deployment Protection is enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Shared secret between this app and api/pdf-to-markdown.py.
# Generate with `openssl rand -hex 24`, must match on both.
PDF_TO_MARKDOWN_SECRET=

# Real user id for the two live-Supabase integration tests.
# Sign in via /login, then copy the id from Supabase Auth -> Users.
TEST_OWNER_ID=

CRON_SECRET=
